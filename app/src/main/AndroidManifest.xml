<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
        Package visibility, narrowly. Screen-saver time must not be counted against a
        child's allowance (D20), and finding out which packages provide one means asking
        the package manager about them. A <queries> intent is the declaration designed for
        exactly this, and avoids QUERY_ALL_PACKAGES, which Play reviews as a restricted
        permission (see the Play notes in #14).
    -->
    <queries>
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      The lock is drawn as a TYPE_APPLICATION_OVERLAY window (D16). On Google TV there is
      normally no UI to grant this to a sideloaded app, so setup grants the app-op over ADB —
      and an app-op for a permission the app does not declare has no effect at all, which is
      why this line matters.

      This replaced an accessibility service. That asked to read everything on screen and every
      keystroke; this asks to draw on top. In an app a parent has to trust with the family
      television, that difference is the point.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Granted over ADB: appops set app.tvsitter.tv GET_USAGE_STATS allow -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed to enumerate and name the child's apps when building rules. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Nothing revives this service for free any more. An accessibility service came back about
      27 seconds after a reboot without being asked (D13); a foreground service has to keep
      itself alive, which is what these are for.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Both backup attributes are set on purpose. allowBackup="false" covers Android 11 and
      lower; on Android 12+ it does not reliably disable device-to-device transfer, which is
      manufacturer-dependent, so dataExtractionRules excludes that explicitly. Lint asks for
      fullBackupContent as well, but with backup switched off outright it would have no
      effect, hence the suppression.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Not exported: only this app starts it, and only from the setup screen. It asks for
            the current PIN before it will take a new one, which is what stops a change screen
            from being the way past the lock.
        -->
        <activity
            android:name=".PinActivity"
            android:exported="false" />

        <service
            android:name=".EnforcerService"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces parental screen-time limits on this television" />
        </service>

        <!--
            directBootAware so LOCKED_BOOT_COMPLETED is delivered at all: a receiver that is
            not gets nothing until the user is unlocked, which is the delay being measured.
            It brings an obligation with it — code running before unlock must not touch
            credential-encrypted storage, which is where everything this app persists lives.
        -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An update stops the app and nothing else starts it again. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
