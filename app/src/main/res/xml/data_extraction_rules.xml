<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores MQTT broker credentials and the parent PIN. Neither belongs in a cloud
  backup or a device-to-device transfer, so both are excluded outright. This complements
  android:allowBackup="false", which covers releases before Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
