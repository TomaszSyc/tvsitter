<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF16232E" />
        </shape>
    </item>
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="3dp"
                android:color="#FF4CC2A5" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
