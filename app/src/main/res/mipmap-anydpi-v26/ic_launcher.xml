<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive since API 26, with a monochrome layer so a themed launcher can tint it rather than
  drawing our own colours into somebody's chosen palette. That layer is the current standard and
  costs one extra file.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
